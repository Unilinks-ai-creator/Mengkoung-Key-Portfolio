rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'mengkoungkey7777@gmail.com';
    }

    // Public site reads project cards; only admin writes.
    match /featuredWork/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // About + Contact singletons for the site header/footer/about page.
    match /siteConfig/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
